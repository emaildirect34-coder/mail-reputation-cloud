[Unit]
Description=Verify and publish the initial Email Direct TLSA for %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/kumo-agent/env
EnvironmentFile=/etc/kumo-agent/dane-%i.env
ExecStart=/usr/bin/python3 /usr/local/lib/email-direct/verify-smtp-tlsa.py ${DANE_DOMAIN} ${DANE_MX} ${DANE_FINGERPRINT} --app-origin ${DANE_APP_ORIGIN}
TimeoutStartSec=6min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
